# Copy these values into Railway Variables; do not commit real credentials.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-secret-random-value-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=your-service.up.railway.app,healthcheck.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-service.up.railway.app
# Select the reference from your PostgreSQL service in Railway.
DATABASE_URL=${{Postgres.DATABASE_URL}}
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=3600
API_TOKEN_TTL_HOURS=12
DJANGO_EMAIL_BACKEND=apps.operations.email_backend.ResendEmailBackend
RESEND_API_KEY=replace-with-your-server-side-resend-api-key
DJANGO_DEFAULT_FROM_EMAIL=notificaciones@your-verified-domain.com
ACCOUNTING_NOTIFICATION_EMAILS=contabilidad@example.com
OPERATIONS_NOTIFICATION_EMAILS=operaciones@example.com
DJANGO_EMAIL_TIMEOUT=15
DJANGO_LOG_LEVEL=INFO
