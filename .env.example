DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-this-with-a-random-value-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=sqlite:///db.sqlite3
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO
API_TOKEN_TTL_HOURS=12
ACCOUNTING_NOTIFICATION_EMAILS=contabilidad@example.com
OPERATIONS_NOTIFICATION_EMAILS=operaciones@example.com
# HTTPS alternative for Railway plans without outbound SMTP:
# DJANGO_EMAIL_BACKEND=apps.operations.email_backend.ResendEmailBackend
# RESEND_API_KEY=configure-on-server-only
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=no-reply@example.com

# Solo para ejecutar el comando create_admin_from_env
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password
